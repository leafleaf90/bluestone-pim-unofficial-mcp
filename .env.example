PAPI_KEY=your-papi-key-here
MAPI_CLIENT_ID=your-mapi-client-id
MAPI_CLIENT_SECRET=your-mapi-client-secret

# ─── Remote (Vercel) deployment ───────────────────────────────────────────────

# Required. Master secret for sealing auth codes, access tokens, and refresh records.
# Minimum 32 characters; shorter values make the server fail closed.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIGNING_SECRET=

# Rotation: set SIGNING_SECRET to the new value and keep the old one here (comma
# separated for more than one) until old tokens have expired, then remove it.
# SIGNING_SECRET_PREVIOUS=

# Kill switch: tokens issued before this Unix timestamp (seconds) are rejected.
# TOKEN_NOT_BEFORE=

# Optional. Defaults to "test" (api.test.bluestonepim.com).
# Set to "production" only with production credentials and with full awareness
# that write operations (create_product) will affect live data.
# ENVIRONMENT=production

# ─── Shared store (optional, recommended for shared deployments) ──────────────
# Enables cross-instance rate limits, single-use auth codes, refresh tokens, and
# revocation. Without it the server runs fully stateless with per-instance limits.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# (Vercel KV / Upstash integration also sets KV_REST_API_URL and KV_REST_API_TOKEN, which are accepted.)
# Fail closed when the store is not configured:
# (Also fails closed at runtime: if the store errors, requests get 503 with Retry-After instead
# of falling back to per-instance memory, so replayed codes and revoked tokens are never accepted
# because the store was down. Without it, an outage degrades to per-instance memory and is logged.)
# REQUIRE_SHARED_STORE=true

# ─── Hardening ────────────────────────────────────────────────────────────────

# Hide every write tool for all sessions.
# MCP_READ_ONLY=true

# Public URL of this deployment. Used as issuer and token audience.
# PUBLIC_BASE_URL=https://your-project.vercel.app

# Redirect URI allowlist. Built-in defaults cover Claude, ChatGPT, VS Code, Cursor,
# and loopback. Add exact callback URLs (a trailing * makes a prefix match).
# REDIRECT_URI_ALLOWLIST=https://app.example.com/oauth/callback
# Extra https hosts to trust entirely. Weaker than exact URIs. "*" opens the allowlist.
# REDIRECT_URI_HOST_ALLOWLIST=
# Extra custom schemes, honoured only when the allowlist is open ("*" above).
# EXTRA_REDIRECT_SCHEMES=

# Browser Origins allowed on /mcp (native clients send none). "*" disables the check.
# MCP_ALLOWED_ORIGINS=https://tools.example.com

# Legacy Claude Desktop flow that puts credentials in client_id. On by default.
# ALLOW_LEGACY_CLIENT_ID_FLOW=false
# Temporary escape hatch for clients that omit redirect_uri or client_id at /token.
# LENIENT_TOKEN_REDIRECT_CHECK=true

# Try MCP elicitation for write confirmation on stateless HTTP, for clients known
# to keep the response stream open. Default off; the preview and token flow is used.
# ENABLE_ELICITATION=true

# Extra hosts get_product_image may fetch from (bluestonepim.com is always allowed).
# IMAGE_HOST_ALLOWLIST=

# Local development only: accept x-papi-key and x-mapi-* headers instead of OAuth.
# ALLOW_HEADER_AUTH=true
