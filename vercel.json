{
  "fluid": true,
  "outputDirectory": "build",
  "functions": {
    "api/mcp.ts": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/connect(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/api/mcp" },
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/authorize", "destination": "/api/mcp" },
    { "source": "/token", "destination": "/api/mcp" },
    { "source": "/register", "destination": "/api/mcp" },
    { "source": "/revoke", "destination": "/api/mcp" },
    { "source": "/validate-credentials", "destination": "/api/mcp" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/mcp" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/mcp" },
    { "source": "/.well-known/oauth-protected-resource/mcp", "destination": "/api/mcp" }
  ]
}
